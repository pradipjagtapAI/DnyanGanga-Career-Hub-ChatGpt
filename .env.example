# EXAMPLE ONLY. No working keys. Do not rename this into a public configuration.
# Native Sites: install values through the server environment tool; a local file
# does not configure hosting. Store sensitive entries with is_secret=true.
# For local Wrangler only, copy to .dev.vars (git-ignored) if testing adapters.
CAREER_PUBLIC_ORIGIN=https://dolphin-career-studio.livelymelon2.chatgpt.site

# Jobs: [] is intentionally unconfigured. Approved board records must include
# board, company, rightsConfigId, displayAllowed, digestAllowed, aiAllowed.
CAREER_JOBS_ENABLED=false
GREENHOUSE_BOARDS_JSON=[]

# External AI: all approvals/model/budgets are required; no model is selected.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_IN_SERVER_SECRET_STORAGE
AI_MODEL=REPLACE_WITH_APPROVED_SUPPORTED_MODEL
AI_ALLOWED_MODELS=REPLACE_WITH_APPROVED_SUPPORTED_MODEL
# Server policy: each specialist needs an explicitly approved route. Empty fails
# closed to local self-review; no browser selection or strongest-model assumption.
# Example: {"career_coach":{"provider":"openai","model":"YOUR_APPROVED_MODEL"}}
AI_TASK_ROUTES_JSON={}
AI_DATA_POLICY_APPROVED=false
AI_MAX_OUTPUT_TOKENS=1024
AI_DAILY_REQUEST_LIMIT=20
AI_DAILY_TOKEN_LIMIT=100000
AI_GLOBAL_DAILY_TOKEN_LIMIT=1000000
AI_TIMEOUT_MS=12000

# Documents: additionally requires PRIVATE CAREER_DOCUMENT_PROCESSOR service
# binding and BUCKET:R2Bucket. Flags do not create those capabilities.
DOCUMENT_PROCESSOR_APPROVED=false

# Agent modes, pauses, configurable HH:mm preparation schedule, time zone,
# vault and campaign-specific resume/frequency rules are owned
# database settings, never browser credentials or model-controlled decisions.
# CAREER_SCHEDULER_SECRET also authenticates bounded agent continuations.
# Alerts: the actual separate Worker origin, verified sender(s), secrets and
# independent scheduler deployment are prerequisites; flags alone do not send.
CAREER_ALERTS_ENABLED=false
CAREER_ALERT_RELAY_ORIGIN=https://REPLACE_WITH_OWNED_RELAY_HOST
CAREER_VERIFICATION_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET_AT_LEAST_32_CHARS
CAREER_SCHEDULER_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SERVER_SECRET_AT_LEAST_32_CHARS
RESEND_API_KEY=REPLACE_IN_SERVER_SECRET_STORAGE
RESEND_FROM=REPLACE_WITH_VERIFIED_SENDER
RESEND_SENDER_VERIFIED=false
RESEND_WEBHOOK_SECRET=REPLACE_IN_SERVER_SECRET_STORAGE
WHATSAPP_BUSINESS_TOKEN=REPLACE_IN_SERVER_SECRET_STORAGE
WHATSAPP_APP_SECRET=REPLACE_IN_SERVER_SECRET_STORAGE
WHATSAPP_VERIFY_TOKEN=REPLACE_IN_SERVER_SECRET_STORAGE
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_REGISTERED_SENDER_ID
WHATSAPP_GRAPH_VERSION=REPLACE_WITH_CURRENT_SUPPORTED_VERSION
WHATSAPP_DIGEST_TEMPLATE=REPLACE_WITH_APPROVED_TEMPLATE
WHATSAPP_VERIFICATION_TEMPLATE=REPLACE_WITH_APPROVED_TEMPLATE
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATES_APPROVED=false

# Separate worker/ deployment ONLY (not native site runtime):
# CAREER_SITE_ORIGIN=the existing application HTTPS origin
# SITES_PRIVATE_AUDIENCE=true
# SITES_SERVICE_BEARER=secret, only after explicit authorization for private
#   unattended access; never a browser identity or a candidate credential.
# CAREER_SCHEDULER_SECRET=same independent scheduler secret as the website

# Private document bridge/ deployment ONLY:
# DOCUMENT_PROCESSOR_ORIGIN=protected fixed HTTPS origin
# DOCUMENT_PROCESSOR_TOKEN=private server secret at least 32 characters
# Do not add payment, public-profile sharing or admin-role credentials here.
# These sensitive capabilities remain unavailable pending trusted identity.
